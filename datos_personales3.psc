//Algoritmo que pide datos personales de usuarios
Algoritmo datos_personales3
	
	//definimos las variables
	
	Definir iden, nom, ape, edad, fecha_naci, correo, num_tel Como Caracter
	
    //Entrada de datos
	
	Escribir 'Ingrese numero de identificacion'
	Leer iden
	Escribir 'Ingrese nombre'
	Leer nom
	Escribir 'Ingrese apellido'
	Leer ape
	Escribir 'Ingrese edad'
	Leer edad
	Escribir 'Ingrese fecha de nacimiento'
	Leer fecha_naci
	Escribir 'Ingrese correo'
	Leer correo
	Escribir 'Ingrese numero de telefono'
	Leer num_tel
	
	Imprimir 'su identificacion es:', iden
	Imprimir 'su nombre es: ', nom
	Imprimir 'su apellido es: ', ape
	Imprimir 'su edad es: ', edad
	Imprimir 'su fecha de nacimiento es: ', fecha_naci
	Imprimir 'su correo es: ', correo
	Imprimir 'su telefono es. ', num_tel
	
	Escribir "gracias por su colaboracion"
	
FinAlgoritmo
