Algoritmo calculadora_figuplanas
	Definir a, b, c, h, pt, at, pr, ar, pc, ac Como Real
	
	Escribir "Ingrese el valor de a";
	Leer a
	Escribir "Ingrese el valor de b";
	Leer b
	Escribir "Ingrese el valor de c para encontrar el perímetro del triángulo";
	Leer c
	
	pt = a + b + c
	
	Imprimir "El perimetro del triangulo es: " pt;
FinAlgoritmo
